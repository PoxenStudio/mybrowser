#!/bin/bash

BIN=/usr/bin/poxenstudio-mybrowser-stable

# Cleanup stale singleton lock left over from an unclean container shutdown
if ! pgrep -f "${BIN}" > /dev/null; then
  rm -f /data/mybrowser/Singleton*
fi

# Wayland check
if ls -l /dev/dri/* > /dev/null 2>&1; then
  if pgrep labwc > /dev/null 2>&1; then
    WAYLAND="--ozone-platform=wayland"
  fi
fi

# Pelorus accessibility
if [ "${PELORUS,,}" == "true" ]; then
  ACCESSIBILITY="--force-renderer-accessibility"
fi

# UI language
UI_LANG="${UI_LANG:-zh-CN}"

# Remote debugging port
if [ -n "${ENV_REMOTE_INSPECT_PORT}" ]; then
  if [[ "${ENV_REMOTE_INSPECT_PORT}" =~ ^[0-9]{4,}$ ]] && [ "${ENV_REMOTE_INSPECT_PORT}" -le 65535 ]; then
    REMOTE_INSPECT="--remote-debugging-port=${ENV_REMOTE_INSPECT_PORT}"
  else
    echo "Invalid ENV_REMOTE_INSPECT_PORT: ${ENV_REMOTE_INSPECT_PORT} (must be an integer of 4+ digits, <= 65535)" >&2
  fi
fi

${BIN} \
  --no-first-run \
  --no-sandbox \
  --password-store=basic \
  --simulate-outdated-no-au='Tue, 31 Dec 2099 23:59:59 GMT' \
  --start-maximized \
  --test-type \
  --hide-crash-restore-bubble \
  --user-data-dir='/data/mybrowser' \
  --lang="${UI_LANG}" \
  ${WAYLAND} \
  ${ACCESSIBILITY} \
  ${REMOTE_INSPECT} \
   "$@" > /dev/null 2>&1
